@using Harmony.Components;
@using Microsoft.AspNetCore.Components.Authorization
@page "/match-profile/{matchId}"

<AuthorizeView>
    <Authorized>
        @if (matchViewModel == null || isLoading || InitiatorUser == null || RecipientUser == null)
        {
            <p>Loading profile...</p>
        }
        else
        {
            <div class="container mt-4">
                    <div class="profile-info mt-3">
                        <!-- Modern Profile Card -->
                        <div class="profile-card p-4 mb-4">
                            <div class="d-flex align-items-center gap-4 flex-wrap">
                                <!-- Profile Picture -->
                                <img src="@InitiatorUser.ProfilePictureUrl" alt="Profile Picture" class="profile-pic-large" />
                            <img src="@RecipientUser.ProfilePictureUrl" alt="Profile Picture" class="profile-pic-large" />

                                <!-- User Info -->
                                <div class="user-info-modern flex-grow-1">
                                    <h2 class="user-name">
                                        @(!string.IsNullOrEmpty(InitiatorUser.SpotifyUserId) ? InitiatorUser.SpotifyUserId : InitiatorUser.UserName)
                                    </h2>
                                <h2 class="user-name">
                                    @(!string.IsNullOrEmpty(RecipientUser.SpotifyUserId) ? RecipientUser.SpotifyUserId : RecipientUser.UserName)
                                </h2>
                                </div>
                            </div>
                        </div>
                        <div class="music-profile p-4">
                            @if(matchViewModel.MutualSongs.Count > 0)
                            {
                            <!-- Songs Carousel -->
                            <div class="carousel-header d-flex align-items-center gap-2 mb-3">
                                <h4 class="m-0">Tracks</h4>
                            </div>
                            <div id="songsCarousel" class="carousel slide" data-bs-ride="carousel">
                                <div class="carousel-inner">
                                    @for (int i = 0; i < matchViewModel.MutualSongs.Count; i += 4)
                                    {
                                        var chunk = matchViewModel.MutualSongs.Skip(i).Take(4).ToList();
                                        <div class="carousel-item @(i == 0 ? "active" : "")">
                                            <div class="d-flex justify-content-center gap-4 flex-wrap">
                                                @foreach (var song in chunk)
                                                {
                                                    <div class="song-card text-center">
                                                        <img src="@(string.IsNullOrWhiteSpace(song.AlbumImageUrl) ? "https://static.vecteezy.com/system/resources/previews/009/292/244/non_2x/default-avatar-icon-of-social-media-user-vector.jpg" : song.AlbumImageUrl)" class="album-cover mb-2" />
                                                        <div class="fw-bold song-title text-truncate">@song.Title</div>
                                                        <div class="text-muted small artist-names text-truncate">
                                                            @string.Join(", ", song.Artists.Select(a => a.Name))
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>

                                <button class="carousel-control-prev" type="button" data-bs-target="#songsCarousel" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Previous</span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#songsCarousel" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Next</span>
                                </button>
                            </div>
                            <div class="harmony-divider">
                                <svg viewBox="0 0 1200 20" preserveAspectRatio="none">
                                    <path d="M0,10 L50,0 L100,20 L150,0 L200,20 L250,0 L300,20 L350,0 L400,20 L450,0 L500,20 L550,0 L600,20 L650,0 L700,20 L750,0 L800,20 L850,0 L900,20 L950,0 L1000,20 L1050,0 L1100,20 L1150,0 L1200,10"
                                          stroke="#fac9f4" fill="transparent" stroke-width="2" />
                                </svg>
                            </div>
                            }
                            @if(matchViewModel.MutualArtists.Count > 0)
                            {
                        <!-- Artists Carousel -->
                            
                            <div class="carousel-header d-flex align-items-center gap-2 mb-3 mt-4">
                                <h4 class="m-0">Artists</h4>
                            </div>
                            <div id="artistsCarousel" class="carousel slide" data-bs-ride="carousel">
                                <div class="carousel-inner">
                                    @for (int i = 0; i < matchViewModel.MutualArtists.Count; i += 4)
                                    {
                                        var chunk = matchViewModel.MutualArtists.Skip(i).Take(4).ToList();
                                        <div class="carousel-item @(i == 0 ? "active" : "")">
                                            <div class="d-flex justify-content-center gap-4 flex-wrap">
                                                @foreach (var artist in chunk)
                                                {
                                                    <div class="artist-card text-center">
                                                        <img src="@(string.IsNullOrWhiteSpace(artist.ArtistImageUrl) ? "https://static.vecteezy.com/system/resources/previews/009/292/244/non_2x/default-avatar-icon-of-social-media-user-vector.jpg" : artist.ArtistImageUrl)" class="artist-photo mb-2" />
                                                        <div class="fw-bold artist-name text-truncate">
                                                            @artist.Name
                                                        </div>
                                                        @if (artist.Genres?.Count > 0)
                                                        {
                                                            <div class="text-muted small genres">
                                                                <i class="bi bi-tags me-1"></i>
                                                                @string.Join(", ", artist.Genres.Select(g => g.Name))
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>

                                <button class="carousel-control-prev" type="button" data-bs-target="#artistsCarousel" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Previous</span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#artistsCarousel" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Next</span>
                                </button>
                            </div>
                            }
                            @if(matchViewModel.MutualGenres.Count > 0)
    {
                            <!-- Genres -->
                            <div class="carousel-header d-flex align-items-center gap-2 mb-3 mt-4">
                                <h4 class="m-0">Genres</h4>
                            </div>
                            <div class="genres-list d-flex flex-wrap gap-2">
                                @foreach (var genre in matchViewModel.MutualGenres)
                                {
                                    <span class="badge">
                                        <i class="bi bi-music-note me-1"></i>@genre.Name
                                    </span>
                                }
                            </div>
                            }
                        </div>
                        <hr />
                            <button class="btn btn-danger" @onclick="DeleteMatch">Delete match</button>
                        <hr />
                    </div>
                    </div>
                    }
    </Authorized>

    <NotAuthorized>
        <div class="text-center mt-4">
            <NotAuthorizedLogin />
        </div>
    </NotAuthorized>
</AuthorizeView>

@if (!string.IsNullOrEmpty(matchProfileMessage))
{
    <div class="alert alert-danger" role="alert">
        @matchProfileMessage
        @foreach (var error in errors)
        {
            <div>- @error</div>
        }
    </div>
}
