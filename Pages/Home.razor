@using Microsoft.AspNetCore.Components.Authorization
@using Harmony.Components
@page "/"

<AuthorizeView>
    <Authorized>
        @if(isConnectedToSpotify)
        {
            <MatchList></MatchList>
        }
        else
        {
            <ConnectToSpotify></ConnectToSpotify>
        }
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedLogin></NotAuthorizedLogin>
    </NotAuthorized>
</AuthorizeView>
