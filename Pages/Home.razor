@using Microsoft.AspNetCore.Components.Authorization
@using Harmony.Components
@page "/"
@if (isLoading)
{
    <p>Loading...</p>
}
else
{
    <AuthorizeView>
        <Authorized>
            <h1>Welcome to Harmony!</h1>
            @if (isConnectedToSpotify)
            {
            }
            else
            {
                <ConnectToSpotify></ConnectToSpotify>
            }
        </Authorized>
    <NotAuthorized>
        <NotAuthorizedLogin></NotAuthorizedLogin>
    </NotAuthorized>
</AuthorizeView>
}